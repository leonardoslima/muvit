{
  "name": "@muvit/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:runtime": "pnpm --filter @muvit/validators build",
    "prepare:runtime": "node -e \"if (!process.env.TURBO_INVOCATION_DIR) process.exit(1)\" || pnpm run build:runtime",
    "predev": "pnpm run prepare:runtime",
    "dev": "next dev -p 3000",
    "prebuild": "pnpm run prepare:runtime",
    "build": "next build",
    "start": "next start -p 3000",
    "pretest": "pnpm run prepare:runtime",
    "test": "vitest run --passWithNoTests",
    "pretest:coverage": "pnpm run prepare:runtime",
    "test:coverage": "vitest run --config vitest.global-coverage.config.ts --coverage",
    "pretest:coverage:core": "pnpm run prepare:runtime",
    "test:coverage:core": "vitest run --config vitest.coverage.config.ts --coverage",
    "pretest:coverage:ui": "pnpm run prepare:runtime",
    "test:coverage:ui": "vitest run --config vitest.ui-coverage.config.ts --coverage",
    "pretest:watch": "pnpm run prepare:runtime",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "api:gen": "openapi-ts -i http://localhost:3333/docs/openapi.json -o src/lib/api -c @hey-api/client-fetch"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@muvit/validators": "workspace:*",
    "@sentry/nextjs": "^10.59.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.2",
    "@muvit/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.5"
  }
}
