NODE_ENV=development
API_PORT=3333
DATABASE_URL=postgres://muvit:muvit@localhost:5432/muvit

# Gere um segredo aleatório com pelo menos 32 caracteres e use um valor exclusivo por ambiente.
BETTER_AUTH_SECRET=replace-with-a-secure-secret-at-least-32-chars
# URL pública da própria API, sem barra final.
BETTER_AUTH_URL=http://localhost:3333
# Origem pública exata do dashboard; não use wildcard em produção.
WEB_URL=http://localhost:3000
# Lista separada por vírgulas de schemes/origens Expo confiáveis por ambiente.
EXPO_TRUSTED_ORIGINS=muvit://

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=muvit
R2_PUBLIC_URL=https://cdn.example.com
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM=noreply@muvit.com.br
SENTRY_DSN=https://example@sentry.io/000000
