{
  "expo": {
    "name": "Muvit",
    "slug": "muvit",
    "scheme": "muvit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anonymous.muvit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "sentry-expo",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita que o Muvit use a câmera para tirar fotos da avaliação.",
          "photosPermission": "Permita que o Muvit acesse suas fotos para adicionar imagens à avaliação."
        }
      ]
    ]
  }
}
