          "id": "awGNq",
          "x": 40,
          "y": 906,
          "name": "Contrato de formulário",
          "fill": "$color/text/primary",
          "textGrowth": "fixed-width",
          "width": 1620,
          "content": "Altura mínima 52 dp; aumentar com texto e fonte do sistema. Erro pertence ao campo e não substitui o label.\nSenha: ícone de 24 dp dentro de hit area de 48 dp. Busca mantém input separado do filtro aplicado; não muda comportamento.\nCampo numérico exibe unidade no label ou ao lado do valor; repetições usam inteiro, carga usa decimal.\nA sessão usa Field/Repetições/Imersivo e Field/Carga/Imersivo; em erro, texto explicativo e borda sem depender somente da cor.",
          "lineHeight": 1.4,
          "fontFamily": "$font/family",
          "fontSize": 16,
          "fontWeight": "normal"
        }
