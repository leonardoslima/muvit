              "name": "Título · Prescrição e conteúdo",
              "fill": "$color/text/primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Prescrição e conteúdo",
              "lineHeight": 1.35,
              "fontFamily": "$font/family",
              "fontSize": "$font/size/20",
              "fontWeight": "$font/weight/700"
            },
            {
              "type": "text",
              "id": "MebiX",
              "name": "Contrato · Prescrição e conteúdo",
              "fill": "$color/text/secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Plano A, Treino A e aluno LM são dados demonstrativos. 2 exercícios: Supino reto 3×10 / 60 s e Crucifixo inclinado 3×12 / 45 s. Duração estimada ~11 min pela regra atual. Sem métricas históricas ou semana do plano.",
              "lineHeight": 1.35,
              "fontFamily": "$font/family",
              "fontSize": "$font/size/15",
              "fontWeight": "$font/weight/400"
            }
          ]
        },
        {
          "type": "frame",
