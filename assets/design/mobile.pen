          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "pmNmh",
              "name": "Título · Composição e interação",
              "fill": "$color/text/primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Composição e interação",
              "lineHeight": 1.35,
