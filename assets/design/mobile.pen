            },
            {
              "type": "text",
              "id": "RkFWr",
              "name": "Contrato · Limites offline",
              "fill": "$color/text/secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Hoje pode mostrar cache ou rascunho. Retomada utiliza snapshot existente. Abrir visão geral ainda depende da rede no fluxo atual: cache de Hoje não garante início offline. Não criar novo cache, rota ou regra neste design.",
              "lineHeight": 1.35,
              "fontFamily": "$font/family",
              "fontSize": "$font/size/15",
              "fontWeight": "$font/weight/400"
            }
