            {
              "type": "text",
              "id": "Xgorb",
              "name": "Contrato · Erros e retry",
              "fill": "$color/text/secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Sem dados: StatePanel/Error com Tentar novamente. Durante retry: loading com ação bloqueada. Com conteúdo: ação de texto centralizada dentro de Message/Error; manter treino e exercícios inclusive durante retry. Falha de atualização não usa erro global.",
              "lineHeight": 1.35,
              "fontFamily": "$font/family",
              "fontSize": "$font/size/15",
              "fontWeight": "$font/weight/400"
            }
          ]
        },
        {
