              "lineHeight": 1.4,
              "fontFamily": "$font/family",
              "fontSize": 18,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "fZKyd",
              "name": "Conteúdo Falhas e limites",
              "fill": "$color/text/secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Erro de formato, upload ou salvamento mantém preenchimento e fotos. Não prometer que um erro significa ausência de registro, pois a invalidação também integra a operação. Sem fila offline, rascunho persistente, saída com confirmação, comparação de corpos ou novo visor de fotos.",
              "lineHeight": 1.4,
